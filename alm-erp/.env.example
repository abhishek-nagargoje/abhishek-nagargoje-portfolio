# Copy to server/.env (never commit the real file). Placeholder values only.
# PostgreSQL connection for the application database.
DATABASE_URL=postgres://alm_app:change-me@localhost:5432/alm
# Separate databases used by the automated tests (they are WIPED on every run).
TEST_DATABASE_URL=postgres://alm_app:change-me@localhost:5432/alm_test
E2E_DATABASE_URL=postgres://alm_app:change-me@localhost:5432/alm_e2e
# HTTP port of the API server.
PORT=4000
# development | production. Production enables Secure cookies and serves web/dist.
NODE_ENV=development
# Comma-separated origins allowed to send state-changing requests (same-origin is always allowed).
ALLOWED_ORIGINS=http://localhost:5173
# Serve the built frontend (web/dist) from the API server (recommended in production).
SERVE_WEB=false
# Set to true when running behind a reverse proxy that sets X-Forwarded-For (rate limiting / audit IPs).
TRUST_PROXY=false
# debug | info | warn | error
LOG_LEVEL=info
# Session lifetimes (minutes).
SESSION_IDLE_MINUTES=480
SESSION_ABSOLUTE_MINUTES=10080
# Used only by `pnpm create-admin`. Provide these in your shell for that one command;
# do not store the real password in this file or in source control.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
