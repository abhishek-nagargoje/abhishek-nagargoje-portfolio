{
  "name": "alm-erp",
  "private": true,
  "description": "Meridian ALM – application lifecycle and ERP operations workspace (PostgreSQL backend + React frontend)",
  "engines": { "node": ">=20.11" },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint server/src server/test web/src web/e2e",
    "test": "pnpm --filter server test && pnpm --filter web test",
    "test:e2e": "pnpm --filter web test:e2e",
    "db:migrate": "pnpm --filter server db:migrate",
    "db:seed": "pnpm --filter server db:seed",
    "create-admin": "pnpm --filter server create-admin",
    "start": "pnpm --filter server start"
  },
  "devDependencies": {}
}
